\contentsline {figure}{\numberline {3.1}{\ignorespaces Two illustrative KVP10k test pages with polygon annotation overlays. Red outlines mark annotated regions. The pages are used later to illustrate the fitted annotation-geometry groups.}}{15}{figure.caption.4}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Cluster-count diagnostics for the annotation-geometry analysis: silhouette score, Davies--Bouldin index, Calinski--Harabasz score, and inertia.}}{17}{figure.caption.6}%
