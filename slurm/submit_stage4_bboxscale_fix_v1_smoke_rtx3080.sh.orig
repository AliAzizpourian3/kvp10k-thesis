#!/usr/bin/env bash
#SBATCH --job-name=stage4_bboxscale_smoke
#SBATCH --partition=rtx3080
#SBATCH --gres=gpu:rtx3080:1
#SBATCH --cpus-per-task=4
#SBATCH --time=00:30:00
#SBATCH --output=/home/woody/iwi5/iwi5413h/kvp10k_thesis/logs/%x-%j.out
#SBATCH --error=/home/woody/iwi5/iwi5413h/kvp10k_thesis/logs/%x-%j.err

set -euo pipefail
umask 027

repository_dir="/home/woody/iwi5/iwi5413h/kvp10k_thesis"
python_bin="$repository_dir/env/kvp10k_env/bin/python"
gate3_final="$repository_dir/data/prepared_stage4_bboxscale_fix_v1/manifests/bboxscale_gate3_final.json"
output_root="$repository_dir/data/outputs/stage4_bboxscale_fix_v1/smoke_v1"

export HF_HOME="/home/hpc/iwi5/iwi5413h/.cache/huggingface"
export HUGGINGFACE_HUB_CACHE="$HF_HOME/hub"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-4}"

cd "$repository_dir"

if [[ ! -x "$python_bin" ]]; then
    echo "ERROR: Python interpreter is missing: $python_bin" >&2
    exit 1
fi
if [[ ! -f "$gate3_final" ]]; then
    echo "ERROR: Final Gate 3 artifact is missing: $gate3_final" >&2
    exit 1
fi
if ! jq -e '.verdicts.final_gate3 == "PASS"' "$gate3_final" >/dev/null; then
    echo "ERROR: Final Gate 3 verdict is not PASS" >&2
    exit 1
fi
if [[ -e "$output_root" ]]; then
    echo "ERROR: Refusing to overwrite smoke output: $output_root" >&2
    exit 1
fi

echo "Stage 4 bbox-scale fix v1 isolated smoke"
echo "Job ID: ${SLURM_JOB_ID}"
echo "Node: ${SLURMD_NODENAME}"
echo "Start: $(date --iso-8601=seconds)"
echo "Git head: $(git rev-parse HEAD)"
echo "Gate 3 SHA-256: $(sha256sum "$gate3_final" | cut -d' ' -f1)"
echo "Output root: $output_root"
nvidia-smi --query-gpu=name,memory.total,memory.used,memory.free --format=csv

"$python_bin" -u code/script/smoke_stage4_bboxscale_fix_v1.py

nvidia-smi --query-gpu=name,memory.total,memory.used,memory.free --format=csv
echo "End: $(date --iso-8601=seconds)"
